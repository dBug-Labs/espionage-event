# Database
MONGODB_URI=

# Admin console password (also used by attendance volunteers)
ADMIN_PASSWORD=

# Email (OTP, RSVP, attendance QR, shortlist)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Round 2 code runner
PISTON_API_URL=https://emkc.org/api/v2/piston
PISTON_API_KEY=

# Round 2 AI grading
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Cloudflare Turnstile (checks are skipped when the secret is empty)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Event details
EVENT_DATE=
EVENT_TIME=
EVENT_VENUE=
NEXT_PUBLIC_EVENT_DATE=
NEXT_PUBLIC_EVENT_TIME=
NEXT_PUBLIC_EVENT_VENUE=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_LINK=

# Kill switches: set to true to pause login / OTP routes
LOGIN_PAUSED=
OTP_ROUTES_PAUSED=
NEXT_PUBLIC_LOGIN_PAUSED=
NEXT_PUBLIC_OTP_ROUTES_PAUSED=
